# App variables — read by the server app (tsx / node --env-file-if-exists).
# Copy this file to server/.env and fill in real values.
#
# Note: the port in DATABASE_URL must match POSTGRES_PORT in the root .env
# (read by Docker Compose). The root .env is for Docker Compose; this file
# is for the app.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://slotdesk:changeme@localhost:5432/slotdesk

# Database used by `npm run test:db` only. The name must end in _test so the
# guard in test/db/helpers/db-guard.ts refuses to run against a non-test DB.
TEST_DATABASE_URL=postgresql://slotdesk:changeme@localhost:5432/slotdesk_test
