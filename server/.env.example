# App variables — read by the server app (tsx / node --env-file-if-exists).
# Copy this file to server/.env and fill in real values.
#
# Note: the port in DATABASE_URL must match POSTGRES_PORT in the root .env
# (read by Docker Compose). The root .env is for Docker Compose; this file
# is for the app.
PORT=3000
NODE_ENV=development
# In production this is Neon's direct connection string (the host name without -pooler).
DATABASE_URL=postgresql://slotdesk:changeme@localhost:5432/slotdesk

# Better Auth (D-029). Generate the secret (at least 32 characters) with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Left empty on purpose: the app refuses to start until a real secret is set.
BETTER_AUTH_SECRET=
# The address the browser opens. In development that is Vite on 5173, which
# passes /api on to this server. To try the built app with `npm start`, use
# http://localhost:3000 instead.
BETTER_AUTH_URL=http://localhost:5173
# Optional. Per client address and 15 minutes on /api/orgs: requests that change
# data, and requests of any kind. The defaults are 100 and 600.
# WRITE_RATE_LIMIT=100
# REQUEST_RATE_LIMIT=600
# The bot check on online booking (Cloudflare Turnstile). Required in
# production, where Cloudflare's test keys are refused. Optional elsewhere:
# without them online booking answers 503. Cloudflare's always-pass test keys
# work locally:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Database used by `npm run test:db` only. The name must end in _test so the
# guard in test/db/helpers/db-guard.ts refuses to run against a non-test DB.
TEST_DATABASE_URL=postgresql://slotdesk:changeme@localhost:5432/slotdesk_test
